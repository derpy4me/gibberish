export component VerificationModal inherits Rectangle {
    in property <string> node_id: "";
    in property <string> alias: "";
    in property <string> sas_words: "";
    in property <image> qr_code;
    callback confirm_verification(string);
    callback close_modal();

    background: #000000dd;

    TouchArea {
        // Intercept background clicks
    }

    Rectangle {
        width: 380px;
        height: 460px;
        background: #0f1523;
        border-width: 1px;
        border-color: #475569;
        border-radius: 6px;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: space-between;

            // Header
            Text {
                text: ":: OUT-OF-BAND IDENTITY CEREMONY ::";
                color: #38bdf8;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 0.5px;
                horizontal-alignment: center;
            }

            Text {
                text: alias != "" ? ("Peer Station: " + alias + " (" + node_id + ")") : ("Peer Station: " + node_id);
                color: #f1f5f9;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            // QR Code frame
            Rectangle {
                width: 160px;
                height: 160px;
                background: #ffffff;
                border-radius: 4px;

                Image {
                    source: qr_code;
                    width: 150px;
                    height: 150px;
                    image-fit: contain;
                }
            }

            // SAS 4-word box
            Rectangle {
                height: 52px;
                background: #111827;
                border-radius: 4px;
                border-width: 1px;
                border-color: #f59e0b;

                VerticalLayout {
                    alignment: center;
                    padding: 4px;
                    spacing: 2px;

                    Text {
                        text: "SHORT AUTHENTICATION STRING (SAS)";
                        color: #f59e0b;
                        font-size: 9px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: sas_words != "" ? sas_words : "computing...";
                        color: #f8fafc;
                        font-size: 14px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        horizontal-alignment: center;
                    }
                }
            }

            // Security friction warning text
            Text {
                text: "Compare 4 words out-of-band (verbally or QR).\nIf words differ, do NOT confirm (impersonation risk).";
                color: #fde68a;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // Action buttons (Cancel is low-friction default, Confirm is high-friction deliberate)
            HorizontalLayout {
                spacing: 12px;
                height: 36px;

                // Cancel button (Safe default)
                Rectangle {
                    background: #1e293b;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #334155;
                    horizontal-stretch: 1;

                    TouchArea {
                        clicked => { root.close_modal(); }
                    }

                    Text {
                        text: "[ CANCEL ]";
                        color: #8b9ab0;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Confirm Match button (Deliberate action)
                Rectangle {
                    background: #10b981;
                    border-radius: 4px;
                    horizontal-stretch: 1;

                    TouchArea {
                        clicked => { root.confirm_verification(root.node_id); }
                    }

                    Text {
                        text: "[ CONFIRM MATCH ]";
                        color: #080b11;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
