import { StationRoster, StationItem } from "station_roster.slint";
import { ChatView, ChatMessageItem } from "chat_view.slint";
import { VerificationModal } from "verification_modal.slint";

export { StationItem, ChatMessageItem }

export component MainWindow inherits Window {
    title: "Gibberish Mesh Terminal";
    preferred-width: 860px;
    preferred-height: 560px;
    min-width: 640px;
    min-height: 480px;
    default-font-family: "JetBrains Mono, monospace";
    background: #080b11;

    in property <[StationItem]> stations: [];
    in property <[ChatMessageItem]> messages: [];
    in property <string> active_convo_id: "#all";
    in property <string> active_alias: "Swarm Broadcast";
    in property <string> active_trust_state: "verified";

    // Station & Storage properties
    in property <string> local_node_id: "0xBEBD82B4";
    in property <string> storage_mode: "SD ACTIVE";
    in property <string> storage_stats: "SRAM: 40/256 KB";

    // Telemetry footer properties
    in property <int> tx_packets: 0;
    in property <int> rx_packets: 0;
    in property <int> mesh_channel: 15;
    in property <int> avg_lqi: 0;
    in property <string> dongle_status: "CONNECTED";

    // Verification modal state
    in property <bool> show_verification_modal: false;
    in property <string> verify_node_id: "";
    in property <string> verify_alias: "";
    in property <string> verify_sas_words: "";
    in property <image> verify_qr_image;

    // Callbacks to Rust Controller
    callback select_conversation(string);
    callback send_chat_message(string);
    callback request_verification(string);
    callback confirm_verification(string);
    callback close_verification();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Main split-pane: Station Roster on left (230px fixed), Chat on right
        HorizontalLayout {
            padding: 0px;
            spacing: 0px;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            StationRoster {
                stations: root.stations;
                active_convo_id: root.active_convo_id;
                local_node_id: root.local_node_id;
                storage_mode: root.storage_mode;
                storage_stats: root.storage_stats;
                station_selected(id) => {
                    root.select_conversation(id);
                }
            }

            ChatView {
                messages: root.messages;
                active_convo_id: root.active_convo_id;
                active_alias: root.active_alias;
                trust_state: root.active_trust_state;
                send_message(txt) => {
                    root.send_chat_message(txt);
                }
                open_verify(id) => {
                    root.request_verification(id);
                }
            }
        }

        // Diagnostic Telemetry Footer (Tactical Obsidian)
        Rectangle {
            height: 1px;
            background: #1e293b;
        }

        Rectangle {
            height: 26px;
            background: #080b11;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: "STATION:";
                        color: #8b9ab0;
                        font-size: 9px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.local_node_id;
                        color: #38bdf8;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "|";
                        color: #334155;
                        font-size: 10px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "CH: " + root.mesh_channel + " (802.15.4)";
                        color: #8b9ab0;
                        font-size: 10px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "|";
                        color: #334155;
                        font-size: 10px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "TX: " + root.tx_packets + " | RX: " + root.rx_packets;
                        color: #8b9ab0;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Text {
                        text: "AVG LQI: " + root.avg_lqi;
                        color: #8b9ab0;
                        font-size: 10px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "|";
                        color: #334155;
                        font-size: 10px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.dongle_status == "CONNECTED" ? "[● RADIO: CONNECTED]" : "[○ RADIO: DISCONNECTED]";
                        color: root.dongle_status == "CONNECTED" ? #10b981 : #ef4444;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Modal overlay for SAS / QR verification
    if show_verification_modal: VerificationModal {
        node_id: root.verify_node_id;
        alias: root.verify_alias;
        sas_words: root.verify_sas_words;
        qr_code: root.verify_qr_image;
        confirm_verification(id) => {
            root.confirm_verification(id);
        }
        close_modal => {
            root.close_verification();
        }
    }
}
