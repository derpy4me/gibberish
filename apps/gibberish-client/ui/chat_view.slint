import { ListView, LineEdit } from "std-widgets.slint";

export struct ChatMessageItem {
    id: string,
    convo_id: string,
    sender: string,
    text: string,
    timestamp: string,
    status: string, // "*", "[OK]", "[Q]", "[!]"
    is_outgoing: bool,
    sender_color: color,
}

export component ChatView inherits Rectangle {
    in property <[ChatMessageItem]> messages: [];
    in property <string> active_convo_id: "#all";
    in property <string> active_alias: "Swarm Broadcast";
    in property <string> trust_state: "verified"; // "unverified", "verified"
    callback send_message(string);
    callback open_verify(string);

    forward-focus: input_box;

    background: #0e1420;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // Header Panel
        Rectangle {
            height: 44px;
            background: #111827;
            border-radius: 4px;
            border-width: 1px;
            border-color: #1e293b;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: active_convo_id == "#all" ? "#all (Swarm Broadcast)" : (active_alias != "" ? active_alias : active_convo_id);
                        color: #f1f5f9;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    if active_convo_id != "#all": Rectangle {
                        width: trust_state == "verified" ? 100px : 160px;
                        height: 24px;
                        background: trust_state == "verified" ? #064e3b : #451a03;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: trust_state == "verified" ? #10b981 : #f59e0b;

                        Text {
                            text: trust_state == "verified" ? "[✓ VERIFIED]" : "[? UNVERIFIED CONTACT]";
                            color: trust_state == "verified" ? #10b981 : #f59e0b;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if active_convo_id != "#all" && trust_state != "verified": Rectangle {
                    width: 130px;
                    height: 28px;
                    background: #f59e0b;
                    border-radius: 3px;

                    TouchArea {
                        clicked => { root.open_verify(root.active_convo_id); }
                    }

                    Text {
                        text: "VERIFY IDENTITY";
                        color: #080b11;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Caution Banner for Unverified Direct Chat
        if active_convo_id != "#all" && trust_state == "unverified": Rectangle {
            height: 28px;
            background: #201205;
            border-radius: 3px;
            border-width: 1px;
            border-color: #78350f;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: center;

                Text {
                    text: "[!] CAUTION: Station identity unverified. Compare 4-word SAS string out-of-band.";
                    color: #fde68a;
                    font-size: 10px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        // Messages List (Terminal Gutter-Rail Layout)
        ListView {
            for msg in messages: Rectangle {
                min-height: 28px;
                background: transparent;

                HorizontalLayout {
                    padding-top: 3px;
                    padding-bottom: 3px;
                    padding-left: 2px;
                    padding-right: 8px;
                    spacing: 8px;

                    // Gutter-Rail: 2px Left Accent Strip
                    Rectangle {
                        width: 2px;
                        background: msg.sender_color;
                        border-radius: 1px;
                    }

                    // Gutter: Timestamp (WCAG AA compliant contrast)
                    Text {
                        text: "[" + msg.timestamp + "]";
                        color: #8b9ab0;
                        font-size: 11px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }

                    // Sender Alias with deterministic peer color
                    Text {
                        text: "<" + msg.sender + ">";
                        color: msg.sender_color;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    // Message Body Text (Crisp High Contrast)
                    Text {
                        text: msg.text;
                        color: #f1f5f9;
                        font-size: 12px;
                        font-weight: 500;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }

                    // Delivery Status Rail
                    if msg.status != "": Text {
                        text: msg.status;
                        color: msg.status == "[OK]" ? #10b981 : (msg.status == "[!]" ? #ef4444 : #f59e0b);
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Input Box Container
        Rectangle {
            height: 44px;
            background: #111827;
            border-radius: 4px;
            border-width: 1px;
            border-color: #1e293b;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: space-between;

                input_box := LineEdit {
                    placeholder-text: "Type a message... (Press Enter to send)";
                    font-size: 12px;
                    horizontal-stretch: 1;
                    accepted => {
                        if (self.text != "") {
                            root.send_message(self.text);
                            self.text = "";
                        }
                    }
                }

                Rectangle {
                    width: 90px;
                    height: 32px;
                    background: #2563eb;
                    border-radius: 3px;

                    TouchArea {
                        clicked => {
                            if (input_box.text != "") {
                                root.send_message(input_box.text);
                                input_box.text = "";
                            }
                        }
                    }

                    Text {
                        text: "SEND [↵]";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
